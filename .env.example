# Shiloh Transit environment variables
# Copy to .env.local and fill in real values. Never commit real secrets.

# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Auth.js (NextAuth v5)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pexels API (build time image fetching, see scripts/fetch-pexels.mjs)
PEXELS_API_KEY=

# Vercel KV (booking store; falls back to in-memory storage when unset)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob storage
BLOB_READ_WRITE_TOKEN=

# SMTP (outbound contact emails via nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
